# Un .gitignore es un archivo en el cual se listan nombres de archivo o tipos de archivo
# que git no debe subir al repositorio a la hora de hacer commit

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# debug information files
*.dwo

#lo de arriba era la plantilla basica del .gitignore para C

#Posibles nombres pal ejecutable
pvz
juego
main

#necesario pal malloc
core
vgcore.*

#pa que las configuraciones del vscode de uno no afecten al resto
.vscode/